KC_LOG_LEVEL=debug
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_HOSTNAME_STRICT_HTTPS=false
KC_DB=postgres
KC_DB_SCHEMA=public
KC_DB_URL_PORT=5432
# Use the internal postgres service defined in docker-compose.yml
KC_DB_URL_HOST="postgres"
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=postgres
# KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=false
KC_HOSTNAME="localhost"
KC_HOSTNAME_ADMIN="localhost"
KC_HOSTNAME_PORT=8080
# KC_HTTP_MANAGEMENT_PORT=9081
KC_HTTP_ENABLED=true

# Enable health endpoints
KC_HEALTH_ENABLED=true

# Management interface enabled on 0.0.0.0:9000 (internal only)
KC_HTTP_MANAGEMENT_ENABLED=true
KC_HTTP_MANAGEMENT_HOST="0.0.0.0"
KC_HTTP_MANAGEMENT_PORT=9081

KEYCLOAK_CONFIG_SERVER_URI="http://keycloak:8080"
KEYCLOAK_CONFIG_REALM=master

# When false (default), the realm is configured only if it does not already exist; existing realms are left untouched.
# When true, the realm is deleted and recreated from scratch on every run.
KEYCLOAK_RECREATE_REALM=false

# Test user creation
KEYCLOAK_CREATE_TEST_USERS=true
KEYCLOAK_TEST_USERS_FILE="/config/test-users.json"

# -------------------------------------
# UI client configuration
# -------------------------------------

KEYCLOAK_UI_CLIENT_ID=acode-learn-ui
KEYCLOAK_UI_CLIENT_NAME=Acode Learn UI
KEYCLOAK_UI_CLIENT_DESCRIPTION=Client for the UI application

KEYCLOAK_UI_CLIENT_BASE_URL=http://localhost:4200
KEYCLOAK_UI_CLIENT_ROOT_URL=http://localhost:4200
KEYCLOAK_UI_CLIENT_ADMIN_URL=http://localhost:4200

KEYCLOAK_UI_CLIENT_REDIRECT_URIS=http://localhost:4200/auth,http://localhost:4200,http://localhost:3000/oauth/callback
KEYCLOAK_UI_CLIENT_WEB_ORIGINS=http://localhost:4200
KEYCLOAK_UI_CLIENT_POST_LOGOUT_REDIRECT_URIS=http://localhost:4200/logout,http://localhost:4200

KEYCLOAK_UI_CLIENT_ENABLED=true
KEYCLOAK_UI_CLIENT_FRONTCHANNEL_LOGOUT=true